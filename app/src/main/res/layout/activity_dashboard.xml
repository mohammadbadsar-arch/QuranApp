<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="#F5F5F5"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="مسیر یادگیری شما"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:scaleY="4" />
    <!-- این بخش را در activity_dashboard.xml زیر نوار پیشرفت (ProgressBar/TextView) اضافه کنید -->
<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="آیات یادگرفته‌شده (برای مرور کلیک کنید):"
    android:textSize="16sp"
    android:textStyle="bold"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="8dp"/>

<androidx.recyclerview.widget.RecyclerView
    android:id="@+id/rvPassedVerses"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginBottom="12dp"/>


    <TextView
        android:id="@+id/tvProgressText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="شروع / ادامه مسیر"
        android:textSize="18sp"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF" />

    <!-- دکمه خروج از حساب -->
    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="خروج از حساب"
        android:backgroundTint="#E53935"
        android:textColor="#FFFFFF" />

</LinearLayout>
