<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- بخش آمار و نوار پیشرفت -->
        <TextView
            android:id="@+id/progressStatsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="پیشرفت شما در یادگیری"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginBottom="4dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:progressDrawable="@android:drawable/progress_horizontal"
            android:progressTint="#2E7D32"
            android:layout_marginBottom="16dp" />

        <!-- هدر: شماره آیه و دکمه علاقه‌مندی -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/verseNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textColor="#2E7D32" />

            <ImageButton
                android:id="@+id/favoriteButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/btn_star_big_off"
                android:contentDescription="افزودن به علاقه‌مندی‌ها" />
        </RelativeLayout>

        <!-- دسته‌بندی موضوعی آیه (جدید) -->
        <TextView
            android:id="@+id/categoryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:textColor="#00796B"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- کارت متن عربی -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:contentPadding="16dp">

            <TextView
                android:id="@+id/arabicText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textAlignment="center"
                android:lineSpacingExtra="8dp"
                android:textColor="#000000" />
        </androidx.cardview.widget.CardView>

        <!-- دکمه نمایش ترجمه -->
        <Button
            android:id="@+id/btnShowTranslation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👁 نمایش ترجمه و مصداق (محک زدن خود)"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32"
            android:layout_marginBottom="12dp"
            app:cornerRadius="8dp" />

        <!-- دکمه مشاهده ویدئو (دکمه جدید اضافه شده) -->
        <Button
            android:id="@+id/btnWatchVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎥 تماشای ویدئوی آموزشی"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D84315"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cornerRadius="8dp" />

        <!-- لیست کلمات (جدول نقش‌های نحوی) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/wordsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:layoutDirection="rtl"
            android:visibility="gone" />

        <!-- کارت ترجمه (پیش‌فرض مخفی) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardTranslation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:contentPadding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/translation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:lineSpacingExtra="6dp"
                android:textColor="#424242" />
        </androidx.cardview.widget.CardView>

        <!-- کارت مصداق عملی (پیش‌فرض مخفی) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardExample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:contentPadding="16dp"
            app:cardBackgroundColor="#E8F5E9"
            android:visibility="gone">

            <TextView
                android:id="@+id/exampleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:lineSpacingExtra="6dp"
                android:textColor="#1B5E20" />
        </androidx.cardview.widget.CardView>

        <!-- بخش چک‌باکس‌های ۶ مرحله‌ای -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مراحل یادگیری:"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/checkBox1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:layout_marginBottom="4dp"
            android:text="۱. تلفظ و خواندن صحیح" />

        <CheckBox
            android:id="@+id/checkBox2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:layout_marginBottom="4dp"
            android:text="۲. درک ترجمه و مفهوم" />

        <CheckBox
            android:id="@+id/checkBox3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:layout_marginBottom="4dp"
            android:text="۳. مطالعه مصداق و کاربرد" />

        <CheckBox
            android:id="@+id/checkBox4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:layout_marginBottom="4dp"
            android:text="۴. تعهد به انجام عمل در زندگی" />

        <CheckBox
            android:id="@+id/checkBox5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:layout_marginBottom="4dp"
            android:text="۵. یادگیری کلمات و نقش‌های نحوی" />

        <CheckBox
            android:id="@+id/checkBox6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:layout_marginBottom="8dp"
            android:text="۶. تسلط کامل و مرور نهایی" />

        <!-- دکمه‌های ناوبری (قبلی و بعدی) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:weightSum="2">

            <Button
                android:id="@+id/btnPrevious"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="آیه قبلی"
                android:textSize="16sp"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <Button
                android:id="@+id/nextButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="آیه بعدی"
                android:textSize="16sp"
                android:enabled="false"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- دکمه بازگشت به داشبورد -->
        <Button
            android:id="@+id/btnBackToDashboard"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:text="بازگشت به داشبورد"
            android:textSize="16sp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    </LinearLayout>
</ScrollView>
